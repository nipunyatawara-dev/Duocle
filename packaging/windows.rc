1 24 "packaging/windows.manifest"
2 ICON "assets/duocle.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,3
PRODUCTVERSION 1,0,0,3
FILEFLAGSMASK 0x3fL
FILEOS 0x00040004L
FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Duocle desktop focus utility"
            VALUE "FileVersion", "1.0.0.3"
            VALUE "OriginalFilename", "Duocle.exe"
            VALUE "ProductName", "Duocle"
            VALUE "ProductVersion", "1.0 (3)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
